# Normalize line endings in the repository, regardless of the contributor's
# platform. Windows' core.autocrlf would otherwise turn every file into a
# CRLF-vs-LF diff the moment someone on macOS or Linux touches it.
* text=auto eol=lf

# Explicit, because these must stay LF on every platform.
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary assets (none today, pinned so a future one cannot be mangled).
*.png binary
*.jpg binary
*.webp binary
*.gif binary
