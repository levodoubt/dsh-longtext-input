# Dependencies
node_modules/

# Build output (this plugin ships hand-written plain JS under lib/, so nothing
# here is generated — kept for anyone who later adds a bundler)
dist/
*.tsbuildinfo

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch used by scripts/check.mjs
*.log

# Packaged release artifacts. The market's `tarball:` field points at the asset
# attached to a GitHub Release, never at a committed file, so a stray `npm pack`
# output in the working tree must not be committable.
*.tgz
